{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/marketing/layout,_N_T_/marketing/dashboard/layout,_N_T_/marketing/dashboard/page,_N_T_/marketing/dashboard"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/marketing/dashboard/__PAGE__",
    "/marketing/dashboard",
    "/marketing",
    "/_index",
    "/_head"
  ]
}